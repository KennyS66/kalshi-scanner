venv/
__pycache__/
*.pyc
.env
gh_2.49.0_linux_amd64/
logs/

# Tuner sweep output — regenerable from bot_tuner.py --daemon (126MB+ of
# per-config replay journals); never tracked, and auto_commit_cron's `git add -A`
# would otherwise sweep it into the repo permanently.
data/bot/tuner_sweep/

# Calibration runtime state — accumulated locally, not part of repo
data/whales/picks_log.jsonl
data/whales/picks_outcomes.json
data/whales/calibration.json

# Live pick files — runtime state, not part of repo
data/whales/btc_15m_pick.json
data/whales/btc_d_pick.json

# Signal feature log + alert files — runtime state, not part of repo
data/whales/signal_feature_log.jsonl
data/whales/gate_history.log
data/whales/GATE_PASSED.flag
data/whales/paper_trades.jsonl
data/whales/paper_calls.jsonl
data/whales/trade_log.jsonl
data/bot/session_report_history.log
data/entry_alert.txt
data/exit_alert.txt
data/prewarn_alert.txt

# Local Claude Code config (but DO track shared project slash commands)
.claude/*
!.claude/commands/

# NOTE: data/whales/daily_thesis.jsonl is intentionally TRACKED (not ignored):
# it is the shared daily-thesis journal synced between the cloud pre-market
# routine (writes + pushes) and the local /marketloop (pulls via start.sh).

# Live account mirror (personal trading data, not the bot's record)
data/manual/

# wsrig capture tapes: derived, reproducible, and large (~41 MB per 7-day run,
# growing ~6 MB/day as hourly gzip files). auto_commit_cron.sh runs `git add -A`
# and pushes, so without this the daily snapshot would commit the live capture
# to GitHub and bloat history with data that is regenerable by re-running the rig.
data/wsrig/
data/wsrig-smoke/

# Kalshi history backfill (kalshi_backfill.py) — raw API cache + rebuilt
# feature rows, ~1GB and regenerable; auto_commit_cron's `git add -A` must not
# sweep it in.
data/whales/backfill/
# Official KXBTC15M results cache (settlement.py) — runtime state, rebuilt on demand
data/whales/kalshi_results.json
